<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- YOOTOOB(theme): these are the LIGHT values; values-night/colors_mobile.xml holds the dark
         ones. A colour with no night entry is the same in both themes: everything drawn over pictures,
         and the aliases that point at a brand token (colors_yootoob.xml carries its own night side). -->
    <color name="mobile_color_primary">@color/yoo_accent</color>
    <color name="mobile_color_primary_dark">@color/yoo_accent_pressed</color>
    <!-- Cast: the icon tint that shows a live connection, in the brand accent. -->
    <color name="mobile_color_cast_active">@color/yoo_accent</color>
    <color name="mobile_color_background">#FBFAFE</color>
    <color name="mobile_color_surface">#FEFDFF</color>
    <color name="mobile_color_on_surface">#14121C</color>
    <color name="mobile_color_on_surface_secondary">#5E5A6E</color>
    <color name="mobile_color_badge_bg">#CC000000</color>
    <color name="mobile_color_badge_live_bg">#CCD32F2F</color>
    <color name="mobile_color_progress_track">#33FFFFFF</color>
    <!-- YOOTOOB(seek bar): the played colour of every progress line (watched bars on thumbnails,
         the mini player's), the same token as the seek bar (PlayerTimeBar.PLAYED_COLOR). -->
    <color name="mobile_color_progress">@color/yoo_progress</color>
    <color name="mobile_color_placeholder">#ECEAF2</color>
    <!-- NEWTUBE(motion): the light that sweeps over skeleton blocks (ShimmerLinearLayout). -->
    <color name="mobile_color_skeleton_highlight">#F7F6FB</color>
    <color name="mobile_color_link">@color/yoo_accent</color>
    <color name="mobile_color_qr_bg">#FFFFFF</color>
    <color name="mobile_color_divider">#1A14121C</color>
    <color name="mobile_color_pill">#0D14121C</color>
    <!-- Opaque equivalent of the translucent pill over #0F0F0F. MaterialButton flattens a
         translucent background tint onto its white base, which made white "Subscribed" text
         disappear into a white button on-device. -->
    <color name="mobile_color_subscribed_button">#F1EFF7</color>
    <!-- NEWTUBE(comments-panel): the comment a replies page is about, set apart from its replies. -->
    <color name="mobile_color_comment_parent">#F1EFF7</color>
    <!-- The creator's handle on their own comments, and the panel's Top / Newest menu. -->
    <color name="mobile_color_comment_creator_pill">#1414121C</color>
    <color name="mobile_color_menu_surface">#FEFDFF</color>
    <!-- A commenter's handle: brighter than the time beside it, quieter than the comment. -->
    <color name="mobile_color_comment_handle">#2E2B38</color>

    <!-- NEWTUBE(theme): tokens added with the light theme (night values in values-night). -->
    <!-- A raised card on the page: the watch page's Comments / Live chat / queue cards. -->
    <color name="mobile_color_card">#F3F1F8</color>
    <!-- The app's one main-action pill ("Play all", "Subscribe", "Sign in"): white on the dark
         page, near-black on the light one, like YouTube's. -->
    <color name="mobile_color_inverse_surface">#14121C</color>
    <color name="mobile_color_on_inverse_surface">#FEFDFF</color>
    <color name="mobile_color_inverse_ripple">#33FFFFFF</color>
    <!-- The unfilled part of a progress bar on a page or sheet (not over a picture). -->
    <color name="mobile_color_track">#1F14121C</color>
    <!-- Search box: a grey pill on the light top bar; the dark one keeps its old look. -->
    <color name="mobile_color_field">#F0EEF6</color>
    <!-- The page colour at 40%, for the playlist header's wash into the page. -->
    <color name="mobile_color_background_scrim">#66FBFAFE</color>
    <!-- The navigation bar. Black here: Android 7-8.0 can't draw dark navigation buttons, so a
         white bar would hide them; values-v27 has the white one that matches the page. -->
    <color name="mobile_color_navigation_bar">#000000</color>

    <!-- NEWTUBE(theme): the shared edit dialogs (SimpleEditDialog - new/rename playlist, passwords -
         and WebProxyDialog) use the library's fixed dark AppDialog colours; the light side
         overrides them here, values-night keeps the library's values. -->
    <color name="dialog_bg_color">#FEFDFF</color>
    <color name="dialog_text_color">#14121C</color>
    <color name="dialog_hint_color">#6114121C</color>
    <color name="dialog_proxy_hint_color">#8A14121C</color>

    <!-- NEWTUBE(theme): player chrome, the same in BOTH themes - the player stays dark like
         YouTube's: controls and chips over the video, the mini player, the cast overlays. -->
    <color name="mobile_player_on_video">#FFFFFF</color>
    <color name="mobile_player_pill">#26FFFFFF</color>
    <color name="mobile_player_cast_active">#4FC3F7</color>

    <!-- Surface layers (light): page < glass surface < card < control. -->
    <color name="mobile_glass_surface">#F4F2FA</color>
    <color name="mobile_glass_surface_card">#FEFDFF</color>
    <color name="mobile_glass_surface_control">#ECEAF3</color>
    <color name="mobile_glass_highlight">@android:color/transparent</color>
    <color name="mobile_glass_outline">#1A14121C</color>
    <color name="mobile_glass_outline_subtle">#1014121C</color>
    <color name="mobile_glass_divider">#1A14121C</color>
    <color name="mobile_glass_shadow">#141E1440</color>

    <!-- Navigation: the accent marks the current destination; inactive stays neutral (4.6:1). -->
    <color name="mobile_floating_nav_active">@color/yoo_accent</color>
    <color name="mobile_floating_nav_inactive">#6E6980</color>
</resources>
