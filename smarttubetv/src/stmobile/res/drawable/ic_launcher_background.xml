<?xml version="1.0" encoding="utf-8"?>
<!--
  YooToob adaptive-icon background (stmobile flavor).

  Full-bleed 108x108 layer; the launcher applies its own mask (circle / rounded square /
  squircle). Brand violet with a slightly deeper lower-right wedge for depth, done with a second
  path rather than a gradient tag so it renders identically on every launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/yoo_brand_canvas"
        android:pathData="M0,0h108v108h-108z" />
    <path
        android:fillColor="#4E31E6"
        android:pathData="M108,24 L108,108 L24,108 Z" />
</vector>
