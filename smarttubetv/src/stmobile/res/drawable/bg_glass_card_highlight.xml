<?xml version="1.0" encoding="utf-8"?>
<!--
  YooToob glass rim: the lit top edge of a floating glass card (the mini player). A faint white
  fading to nothing over the top 18dp, the same light the floating dock's top edge catches, so
  the floating layers read as one material. Over video only; never over text.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="@dimen/mobile_glass_corner_radius_card"
        android:topRightRadius="@dimen/mobile_glass_corner_radius_card"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
    <gradient
        android:angle="270"
        android:startColor="#29FFFFFF"
        android:endColor="#00FFFFFF"
        android:type="linear" />
</shape>
